--- /dev/null
+++ b/dhcpy6d/pidfile.py
@@ -0,0 +1,15 @@
+"""PID-file lifecycle helpers for dhcpy6d."""
+
+import atexit
+import os
+from pathlib import Path
+
+
+def write_pid_file(path):
+    """Write the current daemon PID and remove the file at clean exit."""
+    if not path:
+        return
+    pid_file = Path(path)
+    pid_file.parent.mkdir(parents=True, exist_ok=True)
+    pid_file.write_text(f'{os.getpid()}\n')
+    atexit.register(lambda: pid_file.unlink(missing_ok=True))
--- /dev/null
+++ b/tests/test_pid_file.py
@@ -0,0 +1,17 @@
+import os
+import tempfile
+import unittest
+
+from dhcpy6d.pidfile import write_pid_file
+
+
+class PidFileTest(unittest.TestCase):
+    def test_writes_current_pid(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = os.path.join(directory, 'run', 'dhcpy6d.pid')
+            write_pid_file(path)
+            with open(path) as handle:
+                self.assertEqual(handle.read(), f'{os.getpid()}\n')
+
+    def test_empty_path_is_ignored(self):
+        self.assertIsNone(write_pid_file(None))
