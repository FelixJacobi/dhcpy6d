+        else:
+            lab, _ = self.acquire()
+            lab.release()
+            released = lab.packet(8)
+        lab.packet(7, since=released['time'], predicate=lambda e: inner(e)[1:4] == inner(released)[1:4])
+        if CLIENT != 'kea':
+            lab.wait(lambda: not lab.rows('prefixes') and not lab.rows('leases'),
